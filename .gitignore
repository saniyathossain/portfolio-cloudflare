# ── OS ──────────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor / IDE (local only) ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── Node / package tooling (docs/aidlc/52 — package.json + Astro) ──────────────────
node_modules/
npm-debug.log*
*.log
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
coverage/

# ── Build output ───────────────────────────────────────────────────────────────────
# Astro (planned): generated site + type cache. public/ stays committed (current deploy root).
dist/
.astro/
# Legacy standalone Tailwind binary (Tailwind is now the pinned npm @tailwindcss/cli)
bin/
# Generated by ./build.sh (esbuild / Tailwind / minify-css) — rebuilt on every deploy, never hand-edited.
# NOT ignored on purpose: the image derivatives under public/assets/img (committed so a build never has to regenerate
# them; scripts/optimize-images.ts + scripts/img-cache.json skip anything whose master is unchanged).
public/assets/js/*.min.js
# Service worker + client bundles are built from src/client/*.ts (docs/aidlc/60)
public/sw.js
public/assets/css/*.min.css
public/assets/css/tailwind.css
src/generated/
public/assets/css/brands.css
public/assets/css/brands.critical.css
# Astro / Vite / TypeScript / tool caches
.vite/
*.tsbuildinfo
.cache/
.turbo/
.parcel-cache/
.nyc_output/
# Test / lint / bundle-analysis output
playwright-report/
test-results/
.eslintcache
stats.html

# Parity baselines (docs/aidlc/53): regenerable binaries/reports stay local; README + capture script are committed
docs/aidlc/assets/*/shots/
docs/aidlc/assets/*/lighthouse/

# ── Cloudflare / secrets ──────────────────────────────────────────────────────────
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example
# Defence in depth: key material and credentials must never be committed by accident.
*.pem
*.key
*.p12
*.pfx
*.crt
*.p8
id_rsa*
id_ed25519*
.npmrc.local
.secrets/
credentials.json
service-account*.json

# ── Agent tooling ──────────────────────────────────────────────────────────────────
# Committed: skills-lock.json, .agents/skills/impeccable/ (vendored, unlocked — powers .codex hook),
#            .claude/launch.json, .cursor/rules/, .cursor/skills/portfolio/, .codex/hooks.json,
#            .impeccable/config.json
# Ignored:   third-party skills (restore: `npx skills experimental_install` from skills-lock.json),
#            their .claude/skills symlinks, per-machine state, logs and vendor duplicates.
.agents/skills/*
!.agents/skills/impeccable/
.claude/skills/
*.local.json
.claude/settings.local.json
.claude/worktrees/
.cursor/debug-*.log
.cursor/hooks.json
.cursor/skills/impeccable/
.cursor/work/
.impeccable/hook.cache.json
.impeccable/hook.pending.json

# ── Legacy dc-runtime site (archived, local only) ───────────────────────────────────
/legacy/
