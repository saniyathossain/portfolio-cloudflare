{
  "$comment": "Outage / error pages rendered as a shell console. One entry per page; the 5W fields mirror the log format in docs/aidlc/54 §6. Served from /errors/<slug>/ (404 also as /404.html). services: each page lists the services it reports; ids must exist in terminal.services.catalog (add `cache`, `dataSource`, … there first).",
  "terminal": {
    "windowTitle": "saniyat — zsh — 80×24",
    "userName": "visitor",
    "hostName": "saniyat.com",
    "promptSymbol": "$",
    "labels": {
      "when": "when",
      "who": "who",
      "what": "what",
      "where": "where",
      "why": "why",
      "hint": "hint",
      "ref": "ref"
    },
    "unknownValue": "—",
    "footer": "Mohammad Saniyat Hossain · Staff Software Engineer",
    "retry": {
      "attemptLabel": "retry",
      "waitingLabel": "in",
      "secondsSuffix": "s",
      "exhausted": "gave up after {attempts} attempts — run retry to try again",
      "reconnected": "back online — reloading",
      "srAnnouncement": "Retrying automatically in {seconds} seconds."
    },
    "well": {
      "requestVerb": "GET"
    },
    "orb": {
      "idleGlyph": "!",
      "secondsLabel": "sec"
    },
    "services": {
      "heading": "services",
      "states": {
        "ok": "ok",
        "degraded": "degraded",
        "down": "down",
        "unknown": "unknown"
      },
      "catalog": {
        "edge": "edge",
        "worker": "worker",
        "assets": "assets",
        "network": "network",
        "cache": "cache",
        "dataSource": "data source"
      }
    }
  },
  "pages": {
    "not-found": {
      "slug": "not-found",
      "status": 404,
      "statusText": "Not Found",
      "level": "ERROR",
      "event": "page_not_found",
      "actor": "edge/router",
      "title": "Page not found",
      "message": "That address does not exist on this site.",
      "reason": "no route or asset matches this URL",
      "hint": "Check the spelling, or head back to the home page.",
      "command": "curl -I {url}",
      "actions": [
        {
          "label": "cd ~",
          "description": "go to the home page",
          "href": "/"
        }
      ],
      "retry": {
        "isEnabled": false
      },
      "services": [
        {
          "id": "edge",
          "state": "ok"
        },
        {
          "id": "worker",
          "state": "ok"
        },
        {
          "id": "assets",
          "state": "ok",
          "detail": "no file at this path"
        }
      ]
    },
    "server-error": {
      "slug": "server-error",
      "status": 500,
      "statusText": "Internal Server Error",
      "level": "ERROR",
      "event": "unhandled_exception",
      "actor": "edge/worker",
      "title": "Something broke on my side",
      "message": "The server hit an unexpected error while handling your request.",
      "reason": "unhandled exception in the request pipeline",
      "hint": "This is not your fault. Try again in a minute.",
      "command": "curl -I {url}",
      "actions": [
        {
          "label": "retry",
          "description": "reload this page",
          "isReload": true
        },
        {
          "label": "cd ~",
          "description": "go to the home page",
          "href": "/"
        }
      ],
      "retry": {
        "isEnabled": true
      },
      "services": [
        {
          "id": "edge",
          "state": "ok"
        },
        {
          "id": "worker",
          "state": "down",
          "detail": "unhandled exception"
        },
        {
          "id": "network",
          "state": "unknown",
          "live": "network"
        }
      ]
    },
    "bad-gateway": {
      "slug": "bad-gateway",
      "status": 502,
      "statusText": "Bad Gateway",
      "level": "ERROR",
      "event": "upstream_failed",
      "actor": "edge/assets",
      "title": "Upstream is not answering",
      "message": "The site's asset store returned an error instead of the page.",
      "reason": "static asset binding responded with a 5xx status",
      "hint": "It is usually brief. Reload in a moment.",
      "command": "curl -I {url}",
      "actions": [
        {
          "label": "retry",
          "description": "reload this page",
          "isReload": true
        },
        {
          "label": "cd ~",
          "description": "go to the home page",
          "href": "/"
        }
      ],
      "retry": {
        "isEnabled": true
      },
      "services": [
        {
          "id": "edge",
          "state": "ok"
        },
        {
          "id": "worker",
          "state": "ok"
        },
        {
          "id": "assets",
          "state": "down",
          "detail": "not answering"
        }
      ]
    },
    "maintenance": {
      "slug": "maintenance",
      "status": 503,
      "statusText": "Service Unavailable",
      "level": "WARN",
      "event": "maintenance_mode",
      "actor": "edge/maintenance-gate",
      "title": "We'll be right back",
      "message": "The site is down briefly for scheduled maintenance and a few improvements. Please check back shortly — or reach me by email in the meantime.",
      "reason": "MAINTENANCE_MODE is on",
      "hint": "No data is lost. Nothing to do but wait.",
      "command": "systemctl status portfolio",
      "actions": [
        {
          "label": "retry",
          "description": "reload this page",
          "isReload": true
        },
        {
          "label": "mail",
          "description": "email me",
          "href": "mailto:{email}"
        }
      ],
      "retry": {
        "isEnabled": true,
        "baseDelayMs": 15000,
        "maxDelayMs": 120000,
        "maxAttempts": 8
      },
      "services": [
        {
          "id": "edge",
          "state": "ok"
        },
        {
          "id": "worker",
          "state": "degraded",
          "detail": "maintenance mode"
        }
      ]
    },
    "offline": {
      "slug": "offline",
      "status": null,
      "statusText": "Offline",
      "level": "WARN",
      "event": "network_unreachable",
      "actor": "browser/service-worker",
      "title": "You're offline",
      "message": "This page isn't saved on your device yet and the network is unreachable.",
      "reason": "navigator reports no connection and nothing is cached",
      "hint": "Reconnect, then retry. Pages you have visited keep working offline.",
      "command": "ping saniyat.com",
      "actions": [
        {
          "label": "retry",
          "description": "reload this page",
          "isReload": true
        }
      ],
      "retry": {
        "isEnabled": true,
        "reloadWhenOnline": true
      },
      "services": [
        {
          "id": "network",
          "state": "down",
          "live": "network"
        },
        {
          "id": "edge",
          "state": "unknown"
        },
        {
          "id": "worker",
          "state": "unknown"
        }
      ]
    }
  },
  "retryDefaults": {
    "baseDelayMs": 2000,
    "factor": 2,
    "maxDelayMs": 60000,
    "maxAttempts": 5,
    "jitterRatio": 0.2,
    "tickMs": 250
  }
}
