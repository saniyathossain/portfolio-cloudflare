---
import type { HTMLAttributes } from "astro/types";
import { iconService } from "../../bootstrap/container";

interface Props extends HTMLAttributes<"span"> {
  /** Icon name from icons.json (an alias, a Lucide id or a social id). */
  name: string;
  /** Class list for the <svg> itself, e.g. "ui-icon ui-icon--md". */
  svgClass?: string;
  /** Wrapper gets aria-hidden unless an ancestor already hides it and the legacy markup omitted it here. */
  isHiddenFromAssistiveTech?: boolean;
}

const { name, svgClass = "ui-icon", isHiddenFromAssistiveTech = true, ...wrapperAttributes } = Astro.props;
---

<span
  aria-hidden={isHiddenFromAssistiveTech ? "true" : undefined}
  {...wrapperAttributes}
  set:html={iconService.render(name, svgClass)}
/>
