---
import { errorCatalog, portfolio } from "../bootstrap/container";
import { fillTemplate } from "../lib/text";
// The page's stylesheet lives in its own file and is inlined at build time, so an outage page never depends on a second request.
import errorPageCss from "../styles/error-page.css?inline";

interface Props {
  /** Key in errors.json → pages. */
  pageKey: string;
}

const { pageKey } = Astro.props;
const page = errorCatalog.pages[pageKey];
if (!page) throw new Error(`errors.json has no page "${pageKey}"`);

const { terminal } = errorCatalog;
const statusLabel = page.status === null ? page.statusText : `${page.status} ${page.statusText}`;
const tone = page.level === "ERROR" ? "is-error" : "is-warn";
const resolveHref = (href: string) => fillTemplate(href, { email: portfolio.profile.email });
// Same arrow glyph the site's pill buttons use (Lucide-style stroke), inlined so the page needs no other file.
const arrowIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
// Prompt chevron for the request line (same stroke language as the arrow chip).
const promptIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>';
const { retryDefaults } = errorCatalog;
const retryConfig = {
  baseDelayMs: page.retry.baseDelayMs ?? retryDefaults.baseDelayMs,
  factor: page.retry.factor ?? retryDefaults.factor,
  maxDelayMs: page.retry.maxDelayMs ?? retryDefaults.maxDelayMs,
  maxAttempts: page.retry.maxAttempts ?? retryDefaults.maxAttempts,
  jitterRatio: retryDefaults.jitterRatio,
  tickMs: retryDefaults.tickMs,
};
const retryCopyForClient = {
  ...terminal.retry,
  reloadWhenOnline: page.retry.reloadWhenOnline === true,
};
const firstDelaySeconds = Math.round(retryConfig.baseDelayMs / 1000);
const idleGlyph = page.status === null ? terminal.orb.idleGlyph : String(page.status);
const orbGlyph = page.retry.isEnabled ? String(firstDelaySeconds) : idleGlyph;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={portfolio.site.themeColor} />
    <title>{page.title} — {portfolio.profile.name}</title>
    <!-- Self-contained on purpose: an outage page must not depend on any other file being reachable. -->
    <style is:inline set:html={errorPageCss}></style>
  </head>
  <body>
    <main class:list={["window", tone]} aria-labelledby="error-title">
      <div class:list={["orb", { "is-counting": page.retry.isEnabled }]} data-orb aria-hidden="true">
        <span class="orb__glass"></span>
        <svg class="orb__ring" viewBox="0 0 100 100" focusable="false">
          <circle class="orb__progress" cx="50" cy="50" r="48.5" pathLength="100" data-orb-progress></circle>
        </svg>
        <span class="orb__value" data-orb-value data-orb-idle={idleGlyph}>
          {orbGlyph}
          {page.retry.isEnabled && <small>{terminal.orb.secondsLabel}</small>}
        </span>
      </div>
      <div class="copy" role="status">
        <h1 id="error-title" data-error-title>
          {page.title}
        </h1>
        <p class="message" data-error-message>
          {page.message}
        </p>
        {page.retry.isEnabled && (
          <p class="sr-only" role="status" data-retry-sr data-retry-sr-template={terminal.retry.srAnnouncement}>
            {terminal.retry.srAnnouncement.replace("{seconds}", String(firstDelaySeconds))}
          </p>
        )}
      </div>
      <div class="well">
        <ul class="well__list" aria-label="Request status">
          <li class="well__line" hidden data-well-request>
            <span class="well__mark" aria-hidden="true" set:html={promptIcon} />
            <span class="well__text"><b>{terminal.well.requestVerb}</b> <span data-well-path></span></span>
          </li>
          <li class="well__line">
            <span class="well__mark well__mark--status" aria-hidden="true"></span>
            <span class="well__text">{statusLabel}</span>
          </li>
          {page.retry.isEnabled && (
            <li
              class="well__line"
              hidden
              data-retry={JSON.stringify(retryConfig)}
              data-retry-copy={JSON.stringify(retryCopyForClient)}
            >
              <span class="well__mark well__mark--retry" aria-hidden="true"></span>
              <span class="well__text" data-retry-text></span>
            </li>
          )}
        </ul>
        {page.services.length > 0 && (
          <>
            <h2 class="well__heading" id="services-heading">
              {terminal.services.heading}
            </h2>
            <ul class="well__list" aria-labelledby="services-heading" data-service-labels={JSON.stringify(terminal.services.states)}>
              {page.services.map((service) => (
                <li class="well__line well__line--service" data-service-state={service.state} data-service-live={service.live}>
                  <span class="well__mark well__mark--service" aria-hidden="true" />
                  <span class="well__text">
                    <b>{terminal.services.catalog[service.id]}</b>
                    {service.detail && <span class="service__detail">{service.detail}</span>}
                  </span>
                  <span class="service__state" data-service-text>
                    {terminal.services.states[service.state]}
                  </span>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
      <ul class="actions">
        {page.actions.map((action) => (
          <li>
            {action.isReload ? (
              <button type="button" data-reload>
                {action.label}
                <span class="chip" aria-hidden="true" set:html={arrowIcon} />
              </button>
            ) : (
              <a href={resolveHref(action.href ?? "/")}>
                {action.label}
                <span class="chip" aria-hidden="true" set:html={arrowIcon} />
              </a>
            )}
          </li>
        ))}
      </ul>
    </main>
    <!-- Optional enhancement: request time/path and the self-healing retry countdown (exponential backoff,
         configured in errors.json). Never throws; the static page is already complete without it. -->
    <script is:inline>
      (function () {
        try {
          var pathEl = document.querySelector("[data-well-path]");
          var requestLine = document.querySelector("[data-well-request]");
          if (pathEl && requestLine) {
            pathEl.textContent = location.pathname + location.search;
            requestLine.hidden = false;
          }

          var storageKey = "retry:" + location.pathname;
          var store = {
            read: function () {
              try {
                var parts = (sessionStorage.getItem(storageKey) || "").split("|");
                var stale = Date.now() - Number(parts[1] || 0) > 10 * 60 * 1000;
                return stale ? 0 : Number(parts[0]) || 0;
              } catch (ignored) {
                return 0;
              }
            },
            write: function (value) {
              try {
                sessionStorage.setItem(storageKey, value + "|" + Date.now());
              } catch (ignored) {}
            },
            clear: function () {
              try {
                sessionStorage.removeItem(storageKey);
              } catch (ignored) {}
            },
          };

          // Services marked live="network" follow the browser's connectivity (the build-time state is the fallback).
          var serviceList = document.querySelector("[data-service-labels]");
          var networkLine = document.querySelector('[data-service-live="network"]');
          if (serviceList && networkLine) {
            var stateLabels = JSON.parse(serviceList.getAttribute("data-service-labels"));
            var syncNetwork = function () {
              var state = navigator.onLine ? "ok" : "down";
              networkLine.setAttribute("data-service-state", state);
              var stateText = networkLine.querySelector("[data-service-text]");
              if (stateText) stateText.textContent = stateLabels[state];
            };
            window.addEventListener("online", syncNetwork);
            window.addEventListener("offline", syncNetwork);
            syncNetwork();
          }

          var reloadButton = document.querySelector("[data-reload]");
          if (reloadButton)
            reloadButton.addEventListener("click", function () {
              store.clear();
              location.reload();
            });

          var orb = document.querySelector("[data-orb]");
          var orbValue = document.querySelector("[data-orb-value]");
          var orbProgress = document.querySelector("[data-orb-progress]");
          var reduceMotion = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;
          // The orb shows a bare glyph (status code / seconds); the unit label under the seconds is static markup.
          var setOrbValue = function (value) {
            if (orbValue && orbValue.firstChild) orbValue.firstChild.nodeValue = value;
          };

          var box = document.querySelector("[data-retry]");
          if (!box) return;
          var config = JSON.parse(box.getAttribute("data-retry"));
          var copy = JSON.parse(box.getAttribute("data-retry-copy"));
          var textEl = box.querySelector("[data-retry-text]");
          var srEl = document.querySelector("[data-retry-sr]");
          var attempt = store.read();

          if (copy.reloadWhenOnline)
            window.addEventListener("online", function () {
              box.hidden = false;
              textEl.textContent = copy.reconnected;
              if (orb) orb.classList.add("is-online");
              location.reload();
            });

          if (attempt >= config.maxAttempts) {
            box.hidden = false;
            textEl.textContent = copy.exhausted.replace("{attempts}", String(attempt));
            if (orb) orb.classList.remove("is-counting");
            if (orbValue) {
              setOrbValue(orbValue.getAttribute("data-orb-idle") || "!");
              var unit = orbValue.querySelector("small");
              if (unit) unit.remove();
            }
            return;
          }

          // delay = min(max, base * factor^attempt), spread by ±jitter so visitors don't retry in lock-step
          var exponential = Math.min(config.maxDelayMs, config.baseDelayMs * Math.pow(config.factor, attempt));
          var spread = 1 + (Math.random() * 2 - 1) * config.jitterRatio;
          var totalMs = Math.max(250, Math.round(exponential * spread));
          var remainingMs = totalMs;
          var lastTick = Date.now();
          var shownSeconds = -1;
          if (srEl)
            srEl.textContent = srEl
              .getAttribute("data-retry-sr-template")
              .replace("{seconds}", String(Math.round(totalMs / 1000)));

          // The ring drains through one CSS animation (no per-frame JS); reduced motion gets a stepped update instead.
          if (orb && orbProgress && !reduceMotion) orb.style.setProperty("--orb-drain-ms", totalMs + "ms");

          var draw = function () {
            var seconds = Math.max(0, Math.ceil(remainingMs / 1000));
            if (reduceMotion && orbProgress) orbProgress.style.strokeDashoffset = String((1 - remainingMs / totalMs) * 100);
            if (seconds === shownSeconds) return; // the DOM only changes once per displayed second
            shownSeconds = seconds;
            textEl.textContent =
              copy.attemptLabel + " " + (attempt + 1) + "/" + config.maxAttempts + " · " + copy.waitingLabel + " " + seconds + copy.secondsSuffix;
            setOrbValue(String(seconds));
            if (orbValue && !reduceMotion && orbValue.animate)
              orbValue.animate(
                [{ opacity: 0.55 }, { opacity: 1 }],
                { duration: 320, easing: "ease-out" },
              );
          };

          box.hidden = false;
          draw();
          // The countdown (and the ring animation) pauses while the tab is hidden, so both stay in sync.
          document.addEventListener("visibilitychange", function () {
            if (orbProgress) orbProgress.style.animationPlayState = document.hidden ? "paused" : "running";
          });
          var timer = setInterval(function () {
            var now = Date.now();
            if (!document.hidden) remainingMs -= now - lastTick;
            lastTick = now;
            if (remainingMs <= 0) {
              clearInterval(timer);
              store.write(attempt + 1);
              location.reload();
              return;
            }
            draw();
          }, config.tickMs);
        } catch (ignored) {
          /* the static page is already complete */
        }
      })();
    </script>
  </body>
</html>
