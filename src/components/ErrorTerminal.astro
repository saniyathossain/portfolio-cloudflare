---
import { errorCatalog, portfolio } from "../bootstrap/container";
import { fillTemplate } from "../lib/text";

interface Props {
  /** Key in errors.json → pages. */
  pageKey: string;
}

const { pageKey } = Astro.props;
const page = errorCatalog.pages[pageKey];
if (!page) throw new Error(`errors.json has no page "${pageKey}"`);

const { terminal } = errorCatalog;
const statusLabel = page.status === null ? page.statusText : `${page.status} ${page.statusText}`;
const levelClass = page.level === "ERROR" ? "badge--error" : "badge--warn";
const hostLabel = `${terminal.userName}@${terminal.hostName}`;
const resolveHref = (href: string) => fillTemplate(href, { email: portfolio.profile.email });
const labelRows = [
  { label: terminal.labels.when, value: undefined, field: "when" },
  { label: terminal.labels.who, value: page.actor },
  { label: terminal.labels.what, value: page.event },
  { label: terminal.labels.where, value: undefined, field: "where" },
  { label: terminal.labels.why, value: page.reason },
  { label: terminal.labels.ref, value: undefined, field: "ref" },
];
const { retryDefaults } = errorCatalog;
const retryConfig = {
  baseDelayMs: page.retry.baseDelayMs ?? retryDefaults.baseDelayMs,
  factor: page.retry.factor ?? retryDefaults.factor,
  maxDelayMs: page.retry.maxDelayMs ?? retryDefaults.maxDelayMs,
  maxAttempts: page.retry.maxAttempts ?? retryDefaults.maxAttempts,
  jitterRatio: retryDefaults.jitterRatio,
  progressWidth: retryDefaults.progressWidth,
  tickMs: retryDefaults.tickMs,
};
const retryCopyForClient = {
  ...terminal.retry,
  reloadWhenOnline: page.retry.reloadWhenOnline === true,
};
const firstDelaySeconds = Math.round(retryConfig.baseDelayMs / 1000);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={portfolio.site.themeColor} />
    <title>{page.title} — {portfolio.profile.name}</title>
    <!-- Self-contained on purpose: an outage page must not depend on any other file being reachable. -->
    <style is:inline>
      :root {
        color-scheme: light;
        --ink: #1d1d1f;
        --muted: #6e6e73;
        --faint: #a1a1a6;
        --paper: #fbfbfc;
        --bar: #e9e9ec;
        --line: #d8d8dc;
        --error: #d62f45;
        --warn: #b8741a;
        --ok: #1f8f4e;
        --link: #0a68d6;
        --accent: #b15f2c;
        --mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace;
      }
      * {
        box-sizing: border-box;
      }
      html {
        -webkit-text-size-adjust: 100%;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 1.25rem;
        font-family: var(--mono);
        color: var(--ink);
        background:
          radial-gradient(60rem 40rem at 85% -10%, rgba(255, 214, 164, 0.22), transparent 60%),
          linear-gradient(160deg, #f6f4f1, #eceae7);
      }
      .window {
        width: min(46rem, 100%);
        border-radius: 0.9rem;
        overflow: hidden;
        background: var(--paper);
        border: 1px solid var(--line);
        box-shadow:
          0 24px 60px -20px rgba(17, 17, 17, 0.28),
          0 2px 6px rgba(17, 17, 17, 0.08);
      }
      .titlebar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.85rem;
        background: linear-gradient(180deg, #f3f3f5, var(--bar));
        border-bottom: 1px solid var(--line);
      }
      .lights {
        display: flex;
        gap: 0.4rem;
      }
      .lights i {
        width: 0.75rem;
        height: 0.75rem;
        border-radius: 50%;
        display: block;
      }
      .lights i:nth-child(1) {
        background: #ff5f57;
      }
      .lights i:nth-child(2) {
        background: #febc2e;
      }
      .lights i:nth-child(3) {
        background: #28c840;
      }
      .window-title {
        flex: 1;
        margin-right: 3.1rem;
        text-align: center;
        font-size: 0.72rem;
        color: var(--muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .screen {
        padding: 1.1rem 1.25rem 1.3rem;
        font-size: 0.86rem;
        line-height: 1.65;
      }
      .line {
        margin: 0;
        overflow-wrap: anywhere;
      }
      .prompt {
        color: var(--ok);
      }
      .host {
        color: var(--accent);
      }
      .cmd {
        color: var(--ink);
      }
      .badge {
        display: inline-block;
        padding: 0 0.55rem;
        margin-right: 0.5rem;
        border-radius: 0.3rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        color: #fff;
      }
      .badge--error {
        background: var(--error);
      }
      .badge--warn {
        background: var(--warn);
      }
      h1 {
        margin: 0.9rem 0 0;
        font-size: 1.05rem;
        font-weight: 700;
      }
      .message {
        margin: 0.35rem 0 0;
        color: var(--muted);
      }
      dl {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0 1rem;
        margin: 1rem 0 0;
        padding: 0.7rem 0.9rem;
        border: 1px solid var(--line);
        background: rgba(0, 0, 0, 0.025);
        border-radius: 0.4rem;
      }
      dt {
        color: var(--faint);
      }
      dd {
        margin: 0;
        overflow-wrap: anywhere;
      }
      .hint {
        margin: 0.9rem 0 0;
        color: var(--muted);
      }
      .hint b {
        color: var(--ok);
        font-weight: 700;
      }
      .actions {
        margin: 1rem 0 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 0.3rem;
      }
      .actions a,
      .actions button {
        font: inherit;
        padding: 0;
        border: 0;
        background: none;
        color: var(--link);
        cursor: pointer;
        text-align: left;
        text-decoration: none;
      }
      .actions a:hover,
      .actions button:hover {
        text-decoration: underline;
      }
      .actions a:focus-visible,
      .actions button:focus-visible {
        outline: 2px solid var(--link);
        outline-offset: 2px;
        border-radius: 0.2rem;
      }
      .actions .desc {
        color: var(--faint);
      }
      .cursor {
        display: inline-block;
        width: 0.55em;
        height: 1.05em;
        margin-left: 0.15rem;
        vertical-align: text-bottom;
        background: var(--ink);
      }
      @media (prefers-reduced-motion: no-preference) {
        .cursor {
          animation: blink 1.1s steps(1) infinite;
        }
      }
      @keyframes blink {
        50% {
          opacity: 0;
        }
      }
      .retry {
        margin: 1rem 0 0;
        color: var(--warn);
      }
      .retry-text {
        display: block;
      }
      .retry-bar {
        display: block;
        color: var(--ok);
        letter-spacing: 0.02em;
      }
      .retry-bar .empty {
        color: var(--faint);
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
      }
      .footer {
        margin: 1rem 0 0;
        padding-top: 0.7rem;
        border-top: 1px dashed var(--line);
        color: var(--faint);
        font-size: 0.72rem;
      }
      @media (max-width: 30rem) {
        .screen {
          font-size: 0.8rem;
          padding: 0.9rem 0.9rem 1.1rem;
        }
        dl {
          grid-template-columns: 1fr;
        }
        dt {
          margin-top: 0.35rem;
        }
      }
    </style>
  </head>
  <body>
    <main class="window" aria-labelledby="error-title">
      <div class="titlebar">
        <span class="lights" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span class="window-title">{terminal.windowTitle}</span>
      </div>
      <div class="screen" role="status">
        <p class="line">
          <span class="prompt">{terminal.promptSymbol}</span>
          <span class="host">{hostLabel}</span>
          <span class="cmd" data-command-template={page.command}>
            {page.command.replace("{url}", terminal.hostName)}
          </span>
        </p>
        <p class="line">
          <span class={`badge ${levelClass}`}>{page.level}</span>
          <span>{statusLabel}</span>
        </p>
        <h1 id="error-title" data-error-title>
          {page.title}
        </h1>
        <p class="message" data-error-message>
          {page.message}
        </p>
        <dl>
          {labelRows.map((row) => (
            <>
              <dt>{row.label}</dt>
              <dd data-field={row.field}>{row.value ?? terminal.unknownValue}</dd>
            </>
          ))}
        </dl>
        <p class="hint">
          <b>{terminal.labels.hint}:</b> {page.hint}
        </p>
        {page.retry.isEnabled && (
          <>
            <p
              class="retry"
              hidden
              data-retry={JSON.stringify(retryConfig)}
              data-retry-copy={JSON.stringify(retryCopyForClient)}
            >
              <span class="retry-text" data-retry-text />
              <span class="retry-bar" data-retry-bar aria-hidden="true" />
            </p>
            <p class="sr-only" role="status" data-retry-sr data-retry-sr-template={terminal.retry.srAnnouncement}>
              {terminal.retry.srAnnouncement.replace("{seconds}", String(firstDelaySeconds))}
            </p>
          </>
        )}
        <ul class="actions">
          {page.actions.map((action) => (
            <li>
              <span class="prompt">{terminal.promptSymbol}</span>
              {action.isReload ? (
                <button type="button" data-reload>
                  {action.label}
                </button>
              ) : (
                <a href={resolveHref(action.href ?? "/")}>{action.label}</a>
              )}
              <span class="desc"> # {action.description}</span>
            </li>
          ))}
        </ul>
        <p class="footer">
          <span class="prompt">{terminal.promptSymbol}</span> <span class="cursor" aria-hidden="true"></span>
          <br />
          {terminal.footer}
        </p>
      </div>
    </main>
    <!-- Optional enhancement: request time/path and the self-healing retry countdown (exponential backoff,
         configured in errors.json). Never throws; the static page is already complete without it. -->
    <script is:inline>
      (function () {
        try {
          var fill = function (name, value) {
            var el = document.querySelector('[data-field="' + name + '"]');
            if (el && value) el.textContent = value;
          };
          fill("when", new Date().toISOString());
          fill("where", location.pathname + location.search);
          var cmd = document.querySelector("[data-command-template]");
          if (cmd) cmd.textContent = cmd.getAttribute("data-command-template").replace("{url}", location.href);

          var storageKey = "retry:" + location.pathname;
          var store = {
            read: function () {
              try {
                var parts = (sessionStorage.getItem(storageKey) || "").split("|");
                var stale = Date.now() - Number(parts[1] || 0) > 10 * 60 * 1000;
                return stale ? 0 : Number(parts[0]) || 0;
              } catch (ignored) {
                return 0;
              }
            },
            write: function (value) {
              try {
                sessionStorage.setItem(storageKey, value + "|" + Date.now());
              } catch (ignored) {}
            },
            clear: function () {
              try {
                sessionStorage.removeItem(storageKey);
              } catch (ignored) {}
            },
          };

          var reloadButton = document.querySelector("[data-reload]");
          if (reloadButton)
            reloadButton.addEventListener("click", function () {
              store.clear();
              location.reload();
            });

          var box = document.querySelector("[data-retry]");
          if (!box) return;
          var config = JSON.parse(box.getAttribute("data-retry"));
          var copy = JSON.parse(box.getAttribute("data-retry-copy"));
          var textEl = box.querySelector("[data-retry-text]");
          var barEl = box.querySelector("[data-retry-bar]");
          var srEl = document.querySelector("[data-retry-sr]");
          var reduceMotion = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;
          var tickMs = reduceMotion ? 1000 : config.tickMs;
          var attempt = store.read();

          if (copy.reloadWhenOnline)
            window.addEventListener("online", function () {
              box.hidden = false;
              textEl.textContent = copy.prefix + " " + copy.reconnected;
              barEl.textContent = "";
              location.reload();
            });

          if (attempt >= config.maxAttempts) {
            box.hidden = false;
            textEl.textContent = copy.exhausted.replace("{attempts}", String(attempt));
            return;
          }

          // delay = min(max, base * factor^attempt), spread by ±jitter so visitors don't retry in lock-step
          var exponential = Math.min(config.maxDelayMs, config.baseDelayMs * Math.pow(config.factor, attempt));
          var spread = 1 + (Math.random() * 2 - 1) * config.jitterRatio;
          var totalMs = Math.max(250, Math.round(exponential * spread));
          var remainingMs = totalMs;
          var lastTick = Date.now();
          if (srEl)
            srEl.textContent = srEl
              .getAttribute("data-retry-sr-template")
              .replace("{seconds}", String(Math.round(totalMs / 1000)));

          var draw = function () {
            var done = Math.round((1 - remainingMs / totalMs) * config.progressWidth);
            textEl.textContent =
              copy.prefix +
              " " +
              copy.attemptLabel +
              " #" +
              (attempt + 1) +
              "/" +
              config.maxAttempts +
              " " +
              copy.waitingLabel +
              " " +
              (Math.max(0, remainingMs) / 1000).toFixed(1) +
              copy.secondsSuffix +
              "\n";
            barEl.innerHTML =
              "[" +
              new Array(done + 1).join(copy.progressFilled) +
              '<span class="empty">' +
              new Array(config.progressWidth - done + 1).join(copy.progressEmpty) +
              "</span>]";
          };

          box.hidden = false;
          draw();
          var timer = setInterval(function () {
            var now = Date.now();
            if (!document.hidden) remainingMs -= now - lastTick; // the countdown pauses while the tab is hidden
            lastTick = now;
            if (remainingMs <= 0) {
              clearInterval(timer);
              store.write(attempt + 1);
              location.reload();
              return;
            }
            draw();
          }, tickMs);
        } catch (ignored) {
          /* the static page is already complete */
        }
      })();
    </script>
  </body>
</html>
