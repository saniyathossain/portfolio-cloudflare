---
import { portfolio, uiConfig } from "../../bootstrap/container";
import Icon from "../ui/Icon.astro";

const { stats, sectionHeadings, copy } = portfolio;
const tileAccents = uiConfig.accents.statTiles;
---

<section class="sec sec-pad-b" aria-label={copy.stats.ariaLabel}>
  <div class="shell">
    <div class="stats-panel spec spec--panel" data-reveal>
      <p class="eyebrow stats-panel__eyebrow">
        <span class="icon-chip icon-chip--sm icon-chip--on-dark" aria-hidden="true">
          <Icon name="chart" svgClass="ui-icon ui-icon--sm" />
        </span>
        <span class="eyebrow-dot stats-panel__eyebrow-dot"></span>
        {copy.stats.eyebrow}
      </p>
      <h2
        class="stats-panel__title mt-4 max-w-md text-2xl font-medium tracking-tight md:text-3xl"
        data-blur-reveal
        data-delay="120"
        set:html={sectionHeadings.stats.heading}
      />
      <ul class="mt-14 stats-grid gap-x-8 gap-y-12">
        {stats.map((stat, statIndex) => (
          <li data-reveal data-delay={statIndex * 55} data-ci={tileAccents[statIndex]}>
            <div class="stats-panel__icon" aria-hidden="true">
              <span class="icon-chip icon-chip--sm icon-chip--on-dark">
                <Icon name={stat.icon} svgClass="ui-icon ui-icon--sm" />
              </span>
            </div>
            <div class="stats-panel__value" data-count="true" data-value={stat.value} data-suffix={stat.suffix}>
              0
            </div>
            <p class="mt-3 text-sm text-white/55">{stat.label}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
