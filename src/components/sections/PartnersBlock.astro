---
import { portfolio } from "../../bootstrap/container";
import { brandColorClass } from "../../lib/brandPalette";

const { partners, copy } = portfolio;
---

<div class="hero-partners" data-reveal data-delay="550">
  <p class="hero-partners__label">{copy.partners.label}</p>
  <div class="hero-partners__list" data-stagger>
    {partners.map((partner) => (
      <a
        class:list={["partner-orb", brandColorClass(partner.color)]}
        tabindex="0"
        href={partner.website}
        target={partner.website ? "_blank" : undefined}
        rel={partner.website ? "noopener noreferrer" : undefined}
        aria-label={partner.website ? `Visit ${partner.name} website` : partner.name}
      >
        <span class="partner-orb__badge">
          {partner.logo ? (
            <img src={partner.logo} alt="" width="16" height="16" loading="lazy" />
          ) : (
            <span class="partner-orb__mono">{partner.name.charAt(0)}</span>
          )}
        </span>
        <span class="partner-orb__tip" role="tooltip">
          <span class="tooltip-shine">{partner.name}</span>
        </span>
      </a>
    ))}
  </div>
</div>
