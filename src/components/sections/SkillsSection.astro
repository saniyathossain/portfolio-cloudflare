---
import { portfolio, uiConfig } from "../../bootstrap/container";
import BrandPill from "../ui/BrandPill.astro";
import Icon from "../ui/Icon.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const { skills, copy, site } = portfolio;
const isFlatLayout = site.features.flags.skillsScrollDesign.enabled;
const groupAccents = uiConfig.accents.skillGroups;
const flatEntries = skills.flatMap((group) => group.items.map((item) => ({ group: group.title, item })));
---

<section id="skills" class="sec sec-pad">
  <div class="shell">
    <SectionHeading sectionId="skills" headingClass="mb-2 text-3xl font-semibold tracking-tight sm:text-4xl" />

    {isFlatLayout ? (
      <div class="skills-flat" x-data="skillsFlatPanel()" x-cloak>
        <div class="skills-flat__panel" id="skills-flat-panel" x-bind:class="skillsFlatOpen && 'is-open'">
          <div class="skills-flat__inner">
            <div class="skills-flat__row pill-row" role="list" aria-label={copy.skills.listLabel}>
              {flatEntries.map((entry, entryIndex) => (
                <BrandPill
                  stackName={entry.item}
                  iconSizePx={46}
                  modifierClass="skills-flat__pill"
                  hasAriaLabel
                  role="listitem"
                  x-show={`showFlatSkill(${entryIndex})`}
                />
              ))}
            </div>
          </div>
        </div>
        <button
          type="button"
          class="skills-flat__toggle"
          x-show="skillsFlatMobile && (skillsFlatMoreCount() > 0 || skillsFlatOpen)"
          x-on:click="toggleSkillsFlat()"
          x-bind:aria-expanded="skillsFlatOpen"
        >
          <span class="skills-flat__toggle-label" x-text="skillsFlatToggleLabel()">
            {copy.skills.viewMore}
          </span>
          <span
            class="skills-flat__toggle-count"
            x-show="!skillsFlatOpen && skillsFlatMoreCount() > 0"
            x-text="`+${skillsFlatMoreCount()}`"
          />
          <span
            class="skills-flat__toggle-chevron"
            aria-hidden="true"
            x-bind:class="{ 'is-open': skillsFlatOpen }"
            x-html="iconSvg('chevronDown', 'ui-icon ui-icon--chevron')"
          />
        </button>
      </div>
    ) : (
      <div class="grid gap-6 md:grid-cols-2">
        {skills.map((group, groupIndex) => (
          <div
            class="glass-panel spec spec--panel"
            data-reveal
            data-delay={groupIndex * 80}
            data-ci={groupAccents[groupIndex]}
          >
            <div class="skills-panel__head">
              <span class="icon-chip" aria-hidden="true">
                <Icon name={group.icon} svgClass="ui-icon ui-icon--md" />
              </span>
              <h3>{group.title}</h3>
            </div>
            <div class="pill-row" data-stagger data-stagger-step="62">
              {group.items.map((item) => (
                <BrandPill stackName={item} iconSizePx={14} />
              ))}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
