---
import { portfolio, uiConfig } from "../../bootstrap/container";
import Icon from "../ui/Icon.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const rowAccents = uiConfig.accents.serviceRows;
---

<section id="services" class="sec sec-pad">
  <div class="shell">
    <SectionHeading
      sectionId="services"
      headingClass="mb-2 max-w-lg text-3xl font-semibold tracking-tight sm:text-4xl"
    />
    <ul class="services-list glass-panel spec spec--panel" data-reveal data-delay="180">
      {portfolio.services.map((service, serviceIndex) => (
        <li class="service-row" data-reveal data-delay={serviceIndex * 50} data-ci={rowAccents[serviceIndex]}>
          <span class="service-row__icon" aria-hidden="true">
            <Icon name={service.icon} svgClass="ui-icon ui-icon--md" />
          </span>
          <div class="service-row__body">
            <h3 class="service-row__title">{service.title}</h3>
            <p class="service-row__desc">{service.desc}</p>
          </div>
          <span class="service-row__arrow" aria-hidden="true">
            <span class="icon-chip icon-chip--sm">
              <Icon name="arrow" svgClass="ui-icon ui-icon--sm" />
            </span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
