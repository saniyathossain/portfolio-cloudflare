# Build-time variables (copy to .env for local builds; gitignored). These are PUBLIC identifiers baked into the static HTML at
# build, so they are read by `npm run build`, not by the Worker at runtime. Each one, when non-blank, overrides the matching
# value in public/assets/data/portfolio.json. Leave blank to keep the JSON value (empty JSON value = feature off, zero requests).
#
# Cloudflare: Dashboard → Workers & Pages → <this Worker> → Settings → Build → "Variables and secrets" (Workers Builds).
# Full reference and "where to update": docs/aidlc/68-analytics-email-env-pagespeed-and-build-hygiene.md

# Google Analytics 4 measurement id, e.g. G-ABCDE12345. Adds the gtag script (hosts already allowed by the CSP).
GOOGLE_ANALYTICS_ID=

# Cloudflare Web Analytics token (beacon). Leave blank: the automatic beacon costs ~10 KB of JS and hurts PageSpeed.
CLOUDFLARE_ANALYTICS_TOKEN=

# Cloudflare Turnstile SITE key (public, starts with 0x…). The matching SECRET is a Worker secret: TURNSTILE_SECRET.
TURNSTILE_SITE_KEY=

# Real-user Web Vitals sampling, 0..1 (docs/aidlc/69). 0 or blank = the collector script is never loaded (zero requests).
# 0.1 = measure 1 in 10 page views. Also needs the Worker var RUM_ENABLED=on and a D1 database bound as DB (docs/aidlc/70).
RUM_SAMPLE_RATE=
